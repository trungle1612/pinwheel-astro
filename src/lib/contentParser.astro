---
import {
  getCollection,
  type CollectionEntry,
  type CollectionKey,
} from "astro:content";
import i18next from "i18next";

type PageData = {
  title: string;
  meta_title?: string;
  description?: string;
  image?: string;
  draft?: boolean;
};

export const getSinglePage = async <C extends CollectionKey>(
  collectionName: C
): Promise<CollectionEntry<C>[]> => {
  const allPages = await getCollection(collectionName);

  let removeIndex = allPages.filter((data) => data.id.match(/^(?!-)/));


  // if i18next.language is ja, remove the index_ja
  if (i18next.language === "ja") {
    removeIndex = allPages.filter((data) => data.id.match(/^ja\/post-\d+/));
  } else {
    removeIndex = allPages.filter((data) => data.id.match(/^post-\d+$/));
  }

  const removeDrafts = removeIndex.filter((data) => {
    const pageData = data.data as PageData;
    return pageData.draft !== true;
  });

  return removeDrafts;
};
---
